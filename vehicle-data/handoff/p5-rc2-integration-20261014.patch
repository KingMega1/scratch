diff --git a/web/scripts/build-catalogue-release.mjs b/web/scripts/build-catalogue-release.mjs
index ba10a80..1eb28a0 100644
--- a/web/scripts/build-catalogue-release.mjs
+++ b/web/scripts/build-catalogue-release.mjs
@@ -2,7 +2,7 @@
 // Read-only serving projection; never writes either vehicle truth or the P1 dataset.
 import { readFileSync, writeFileSync } from 'node:fs';
 import { createHash } from 'node:crypto';
-export function buildCatalogue(snap, u, cw) {
+export function buildCatalogue(snap, u, cw, p2 = {entries:{}}) {
   const norm = s => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
   const ids = new Map(u.models.map(m => [m.id, m]));
   if (ids.size !== u.models.length) throw Error('duplicate U11 identity');
@@ -24,8 +24,14 @@ export function buildCatalogue(snap, u, cw) {
       registration:p.reg?{last12:p.reg.last12??null,first_month:p.reg.first_month??null,window:u.meta.last12_window}:null,
       p2_evidence:!!old, evidence_state:old?'P2_S6_EVIDENCE':'U11_IDENTITY_ONLY',
       price_status:old?.price?.price_from?.status??'UNKNOWN', conflicts:old?.conflicts??[],
-      missing_evidence:old?(old.gaps??[]).map(g=>g.type??g.code??String(g)):['NO_VERIFIED_PRICE','NO_VERIFIED_SPECS','P2_ID_PENDING'] };
+      missing_evidence:old?(old.gaps??[]).map(g=>g.type??g.code??String(g)):['NO_VERIFIED_PRICE','NO_VERIFIED_SPECS','P2_ID_PENDING'],
+      ...(p2.entries[slug] ? {accepted:p2.entries[slug].accepted} : {}) };
   });
+  // P2 RC2 accepted fields (vehicle-data/views/catalogue-serving.release.json), keyed by route: fail closed on unknown route or identity mismatch.
+  for (const [slug, x] of Object.entries(p2.entries)) {
+    const e = entries.find(e => e.site_slug === slug);
+    if (!e || e.p1_id !== x.p1_id) throw Error('P2 accepted overlay identity mismatch: ' + slug);
