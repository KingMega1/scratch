# CarIndex web — environment contract. Never commit real values.
# Public (exposed to browser): only NEXT_PUBLIC_* — none may hold secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# local | preview | staging | production
CI_ENV=local
# Analytics collector: empty = buffer locally only (nothing leaves the browser). "auto" = same-origin /api/v1/events
NEXT_PUBLIC_CI_TRACK_ENDPOINT=
# Feature gates (server-only). Customer PII stays OFF until legal/security/provider readiness is accepted.
FEATURE_CUSTOMER_PII=false
# Admin route protection (server-only). Unset => /admin returns 404.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASS=
# Future (S2+), server-only — never NEXT_PUBLIC_:
# DATABASE_URL=            # Postgres read model (serving projection, not canonical)
# SUPABASE_SERVICE_ROLE_KEY=
# SMS_PROVIDER_API_KEY=
# SMTP_URL=
# CMS_API_TOKEN=
