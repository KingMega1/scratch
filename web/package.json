    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "axe-core": "4.10.3",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
