{
  "parameters": {
    "jsCode": "function extractGeminiText(item) {\n  const j = item.json || {};\n  if (j.content && Array.isArray(j.content.parts)) {\n    return j.content.parts.map(p => p.text || '').join('');\n  }\n  if (typeof j.content === 'string') return j.content;\n  return '';\n}\nfunction extractAnthropicText(item) {\n  const j = item.json || {};\n  if (typeof j.merged_response === 'string' && j.merged_response) return j.merged_response;\n  if (Array.isArray(j.content)) {\n    return j.content.filter(c => c.type === 'text').map(c => c.text).join('');\n  }\n  if (typeof j.content === 'string') return j.content;\n  return '';\n}\nfunction extractOpenRouterText(item) {\n  const j = item.json || {};\n  if (j.choices && Array.isArray(j.choices) && j.choices[0] && j.choices[0].message) {\n    return j.choices[0].message.content || '';\n  }\n  return '';\n}\nlet verdictText = '';\nlet editorSource = 'gpt_oss_openrouter';\ntry {\n  const gptOssItem = $('Editor-in-Chief (GPT-OSS)').item;\n  const gptOssText = extractOpenRouterText(gptOssItem);\n  if (gptOssText) verdictText = gptOssText;\n} catch (e) { /* GPT-OSS branch didn't run in this execution path */ }\nif (!verdictText) {\n  try {\n    verdictText = extractGeminiText($('Editor-in-Chief Fallback (Gemini)').item);\n    editorSource = 'gemini_fallback';\n  } catch (e) { /* Gemini branch didn't run */ }\n}\nif (!verdictText) {\n  try {\n    verdictText = extractAnthropicText($('Editor-in-Chief Fallback (Claude)').item);\n    editorSource = 'claude_fallback';\n  } catch (e) { /* Claude branch didn't run, or all three tiers failed */ }\n}\nconst verdictMatch = verdictText.match(/VERDICT:\\s*(PASS|NEEDS REVISION|REJECT)/i);\nconst hookMatch = verdictText.match(/HOOK_SCORE:\\s*(\\d+)/i);\nconst reasonMatch = verdictText.match(/REASON:\\s*(.+)/i);\nreturn [{\n  json: {\n    ...$('Code in JavaScript').item.json,\n    relevanceScore: $('Parse Triage').item.json.relevanceScore,\n    format: $('Parse Triage').item.json.format,\n    contentPillar: $('Parse Triage').item.json.contentPillar,\n    objectiveTag: $('Parse Triage').item.json.objectiveTag,\n    aiDraft: extractGeminiText($('Parse Content Creation').item),\n    verdict: verdictMatch ? verdictMatch[1].toUpperCase() : 'NEEDS REVISION',\n    hookScore: hookMatch ? parseInt(hookMatch[1], 10) : null,\n    verdictReason: reasonMatch ? reasonMatch[1].trim() : '',\n    editorSource,\n    contentCreationSource: $('Parse Content Creation').item.json.contentCreationSource,\n    auditorSource: $('Parse Auditor').item.json.auditorSource,\n  },\n}];"
