{
  "contract": "carindex.vehicle_intelligence",
  "version": "1.0.0-draft",
  "_how_to_read": "Every attribute a record may carry is declared here. layer = fact | derived | editorial | signal. level = the entity the value is true for (model | cohort | variant | market). coverage_2026_09_10 = share of carindex_master.csv rows with a non-empty source column (measured, not estimated). availability: computable_now | needs_source | needs_editorial.",

  "facts": {
    "model_year":            {"level": "variant", "type": "integer", "unit": null, "master_column": "model_year", "coverage_2026_09_10": 1.00, "availability": "computable_now"},
    "trim_name":             {"level": "variant", "type": "string", "master_column": "variant_raw", "coverage_2026_09_10": 0.98, "availability": "computable_now"},
    "body_type":             {"level": "model", "type": "enum", "enum": ["suv", "sedan", "hatchback", "coupe", "convertible", "pickup", "mpv", "van", "wagon", "other"], "master_column": "body_type_normalized", "coverage_2026_09_10": 0.95, "availability": "computable_now", "note": "77 rows are NOT_AVAILABLE; 20 distinct raw spellings to map"},
    "official_price_egp":    {"level": "variant", "type": "integer", "unit": "EGP", "master_column": "official_price", "coverage_2026_09_10": 0.93, "availability": "computable_now", "time_sensitive": true, "freshness_days": 30},
    "market_price_egp":      {"level": "variant", "type": "integer", "unit": "EGP", "master_column": "market_price", "coverage_2026_09_10": 0.41, "availability": "computable_now", "time_sensitive": true, "freshness_days": 30, "note": "column also holds placeholder text ('Data Not Available', 'Unavailable'); placeholders are raw observations that normalize to unknown"},
    "price_range_egp":       {"level": "cohort", "type": "range", "unit": "EGP", "master_column": "official_price", "availability": "computable_now", "note": "summary rows (e.g. Hatla2ee(summary)) give a min-max for the whole cohort; never assigned to a single trim"},
    "fuel_type":             {"level": "variant", "type": "enum", "enum": ["petrol", "diesel", "mhev", "hev", "phev", "erev", "bev"], "master_column": "fuel_type_raw|powertrain_raw", "coverage_2026_09_10": 0.51, "availability": "computable_now"},
    "engine_displacement_cc":{"level": "variant", "type": "integer", "unit": "cc", "master_column": "engine_capacity", "coverage_2026_09_10": 0.44, "availability": "computable_now"},
    "power_hp":              {"level": "variant", "type": "number", "unit": "hp", "master_column": "horsepower", "coverage_2026_09_10": 0.07, "availability": "needs_source"},
    "torque_nm":             {"level": "variant", "type": "number", "unit": "Nm", "qualifiers": ["rpm_from", "rpm_to"], "master_column": "torque", "coverage_2026_09_10": 0.04, "availability": "needs_source"},
    "transmission":          {"level": "variant", "type": "enum", "enum": ["manual", "automatic", "cvt", "dct", "single_speed", "dht"], "master_column": "transmission", "coverage_2026_09_10": 0.64, "availability": "computable_now"},
    "drivetrain":            {"level": "variant", "type": "enum", "enum": ["fwd", "rwd", "awd", "4wd"], "master_column": "drive_type", "coverage_2026_09_10": 0.05, "availability": "needs_source"},
    "battery_kwh":           {"level": "variant", "type": "number", "unit": "kWh", "master_column": "battery_capacity", "coverage_2026_09_10": 0.02, "availability": "needs_source"},
    "electric_range_km":     {"level": "variant", "type": "number", "unit": "km", "qualifiers": ["test_cycle"], "master_column": "electric_range", "coverage_2026_09_10": 0.01, "availability": "needs_source", "note": "cycle (CLTC/NEDC/WLTP) is almost never recorded; ranges from different cycles are not comparable"},
    "fuel_consumption_l_100km": {"level": "variant", "type": "number", "unit": "L/100km", "qualifiers": ["test_cycle"], "master_column": "fuel_consumption", "coverage_2026_09_10": 0.02, "availability": "needs_source"},
    "energy_consumption_kwh_100km": {"level": "variant", "type": "number", "unit": "kWh/100km", "qualifiers": ["test_cycle"], "master_column": null, "coverage_2026_09_10": 0, "availability": "needs_source"},
    "seats":                 {"level": "variant", "type": "integer", "master_column": "seats", "coverage_2026_09_10": 0.08, "availability": "needs_source"},
    "length_mm":             {"level": "cohort", "type": "integer", "unit": "mm", "master_column": "length", "coverage_2026_09_10": 0.03, "availability": "needs_source"},
    "width_mm":              {"level": "cohort", "type": "integer", "unit": "mm", "master_column": "width", "coverage_2026_09_10": 0.03, "availability": "needs_source"},
    "height_mm":             {"level": "cohort", "type": "integer", "unit": "mm", "master_column": "height", "coverage_2026_09_10": 0.03, "availability": "needs_source"},
    "wheelbase_mm":          {"level": "cohort", "type": "integer", "unit": "mm", "master_column": "wheelbase", "coverage_2026_09_10": 0.03, "availability": "needs_source"},
    "trunk_l":               {"level": "cohort", "type": "integer", "unit": "L", "master_column": "trunk_capacity", "coverage_2026_09_10": 0.03, "availability": "needs_source"},
    "curb_weight_kg":        {"level": "variant", "type": "integer", "unit": "kg", "master_column": null, "coverage_2026_09_10": 0, "availability": "needs_source"},
    "ground_clearance_mm":   {"level": "cohort", "type": "integer", "unit": "mm", "master_column": null, "coverage_2026_09_10": 0, "availability": "needs_source"},
    "turning_circle_m":      {"level": "cohort", "type": "number", "unit": "m", "master_column": null, "coverage_2026_09_10": 0, "availability": "needs_source"},
    "warranty_years":        {"level": "variant", "type": "number", "unit": "years", "master_column": "warranty", "coverage_2026_09_10": 0.34, "availability": "computable_now"},
    "warranty_km":           {"level": "variant", "type": "integer", "unit": "km", "master_column": "warranty", "coverage_2026_09_10": 0.34, "availability": "computable_now"},
    "battery_warranty_years":{"level": "variant", "type": "number", "unit": "years", "master_column": "warranty", "availability": "needs_source", "note": "only present when written inside the warranty text"},
    "assembly_country":      {"level": "cohort", "type": "string", "master_column": "notes (free text)", "availability": "needs_source", "note": "appears in notes for some rows ('Assembled China', 'assembled Turkey'); needs structured extraction + check"},
    "distributor":           {"level": "model", "type": "string", "master_column": null, "availability": "needs_source"},
    "equipment":             {"level": "variant", "type": "object", "master_column": "notes (free text)", "availability": "needs_source", "note": "airbags, cameras, sensors, ADAS, sunroof, seats etc. are only in notes as free text; structured keys: airbags_count, rear_camera, camera_360, parking_sensors_front, parking_sensors_rear, adaptive_cruise, lane_keep, blind_spot, aeb, sunroof, rear_ac_vents, power_seats"},
    "safety_rating":         {"level": "cohort", "type": "object", "fields": ["program", "stars", "test_year", "vehicle_tested"], "master_column": "notes (1 row mentions C-NCAP)", "availability": "needs_source"},
    "registrations_units":   {"level": "model", "type": "timeseries", "unit": "units/month", "master_column": null, "availability": "needs_source", "note": "AMIC/Al-Ahram licensing data exists in CarIndex content work, not in this dataset"},
    "used_listing_count":    {"level": "model", "type": "timeseries", "master_column": null, "availability": "needs_source"},
    "used_price_retention_pct": {"level": "cohort", "type": "number", "master_column": null, "availability": "needs_source"},
    "recall_count":          {"level": "cohort", "type": "integer", "master_column": null, "availability": "needs_source"},
    "service_interval_km":   {"level": "cohort", "type": "integer", "master_column": null, "availability": "needs_source"},
    "service_centers_count": {"level": "model", "type": "integer", "master_column": null, "availability": "needs_source"},
    "brand_years_in_egypt":  {"level": "model", "type": "integer", "master_column": null, "availability": "needs_source"}
  },

  "market_reference_facts": {
    "fuel_price_egp_per_l":     {"type": "number", "qualifiers": ["octane"], "availability": "needs_source", "note": "official Egypt pump price; used by running-cost derivations"},
    "electricity_tariff_egp_per_kwh": {"type": "number", "qualifiers": ["home|public_dc"], "availability": "needs_source"}
  },

  "derived": {
    "price_percentile_in_body_type": {"formula": "D-PRICE-PCTL-BODY@1", "inputs": ["official_price_egp", "body_type"], "peer_set": "all variants with numeric official_price and same body_type, one price per variant, same snapshot", "output": "number 0-100", "availability": "computable_now"},
    "price_band_in_body_type":       {"formula": "D-PRICE-BAND@1", "inputs": ["price_percentile_in_body_type"], "output": "enum entry|lower|middle|upper|top (quintiles)", "availability": "computable_now"},
    "trim_position_in_model":        {"formula": "D-TRIM-POSITION@1", "inputs": ["official_price_egp (all trims of the cohort)"], "output": "enum only_trim|entry|middle|top", "availability": "computable_now"},
    "market_premium_pct":            {"formula": "D-MARKET-PREMIUM@1", "inputs": ["official_price_egp", "market_price_egp"], "constraint": "both from the same source and the same observation date", "output": "number %", "availability": "computable_now"},
    "price_source_agreement":        {"formula": "D-SOURCE-AGREEMENT@1", "inputs": ["official_price_egp observations"], "output": "integer: independent publishers reporting the resolved value", "availability": "computable_now"},
    "length_class":                  {"formula": "D-LENGTH-CLASS@1", "inputs": ["length_mm"], "output": "enum under_4200|4200_4499|4500_4799|4800_plus", "availability": "needs_source"},
    "footprint_m2":                  {"formula": "D-FOOTPRINT@1", "inputs": ["length_mm", "width_mm"], "availability": "needs_source"},
    "third_row":                     {"formula": "D-THIRD-ROW@1", "inputs": ["seats"], "output": "boolean seats >= 6", "availability": "needs_source"},
    "power_to_weight_hp_per_t":      {"formula": "D-POWER-WEIGHT@1", "inputs": ["power_hp", "curb_weight_kg"], "availability": "needs_source"},
    "fuel_cost_egp_per_100km":       {"formula": "D-FUEL-COST@1", "inputs": ["fuel_consumption_l_100km", "fuel_price_egp_per_l"], "availability": "needs_source"},
    "energy_cost_egp_per_100km":     {"formula": "D-ENERGY-COST@1", "inputs": ["energy_consumption_kwh_100km", "electricity_tariff_egp_per_kwh"], "availability": "needs_source"},
    "ev_range_percentile_in_bev":    {"formula": "D-EV-RANGE-PCTL@1", "inputs": ["electric_range_km (same test_cycle)", "fuel_type=bev"], "availability": "needs_source"},
    "warranty_years_percentile":     {"formula": "D-WARRANTY-PCTL@1", "inputs": ["warranty_years"], "peer_set": "all variants with warranty_years, same snapshot", "availability": "computable_now"},
    "registrations_trend":           {"formula": "D-REG-TREND@1", "inputs": ["registrations_units (>= 6 months)"], "availability": "needs_source"},
    "price_trend":                   {"formula": "D-PRICE-TREND@1", "inputs": ["official_price_egp history (>= 2 dated observations)"], "availability": "needs_source", "note": "dataset is one snapshot (collection_date 2026-09-10 on every row)"}
  },

  "signals": {
    "price_position":          {"inputs_required": ["price_band_in_body_type"], "inputs_optional": ["trim_position_in_model", "market_premium_pct"], "editorial_required": false, "availability": "computable_now"},
    "city_suitability":        {"inputs_required": ["length_class", "transmission"], "inputs_optional": ["turning_circle_m", "equipment.parking_sensors_rear", "equipment.rear_camera", "equipment.camera_360"], "editorial_required": true, "availability": "needs_source+editorial"},
    "highway_suitability":     {"inputs_required": ["power_to_weight_hp_per_t"], "inputs_optional": ["equipment.adaptive_cruise", "equipment.lane_keep", "fuel_consumption_l_100km"], "editorial_required": true, "availability": "needs_source+editorial"},
    "family_practicality":     {"inputs_required": ["seats", "trunk_l"], "inputs_optional": ["third_row", "equipment.rear_ac_vents", "wheelbase_mm"], "editorial_required": false, "availability": "needs_source"},
    "running_cost_profile":    {"inputs_required": ["fuel_cost_egp_per_100km|energy_cost_egp_per_100km"], "inputs_optional": ["service_interval_km", "warranty_years"], "editorial_required": false, "availability": "needs_source"},
    "energy_efficiency":       {"inputs_required": ["fuel_consumption_l_100km|energy_consumption_kwh_100km"], "inputs_optional": ["fuel_type"], "editorial_required": false, "availability": "needs_source"},
    "reliability_evidence":    {"inputs_required": ["recall_count|owner_survey"], "inputs_optional": ["brand_years_in_egypt", "registrations_units"], "editorial_required": true, "availability": "needs_source+editorial"},
    "resale_liquidity":        {"inputs_required": ["used_price_retention_pct|used_listing_count"], "inputs_optional": ["registrations_trend"], "editorial_required": false, "availability": "needs_source"},
    "safety_evidence":         {"inputs_required": ["safety_rating"], "inputs_optional": ["equipment.airbags_count", "equipment.aeb", "equipment.blind_spot"], "editorial_required": false, "availability": "needs_source"},
    "performance_character":   {"inputs_required": ["power_to_weight_hp_per_t"], "inputs_optional": ["power_hp", "torque_nm", "transmission", "drivetrain"], "editorial_required": true, "availability": "needs_source+editorial"},
    "comfort":                 {"inputs_required": ["editorial:comfort"], "inputs_optional": ["equipment.power_seats", "wheelbase_mm"], "editorial_required": true, "availability": "needs_editorial"},
    "powertrain_suitability":  {"inputs_required": ["fuel_type", "transmission"], "inputs_optional": ["electric_range_km", "battery_kwh"], "editorial_required": true, "availability": "partly_computable+editorial", "note": "fuel_type/transmission facts are available now; whether a powertrain suits a buyer's use needs editorial rules (charging access, city vs highway)"},
    "ownership_considerations":{"inputs_required": ["distributor", "assembly_country"], "inputs_optional": ["service_centers_count", "brand_years_in_egypt"], "editorial_required": true, "availability": "needs_source+editorial"},
    "service_warranty":        {"inputs_required": ["warranty_years", "warranty_km"], "inputs_optional": ["service_centers_count", "service_interval_km", "battery_warranty_years"], "editorial_required": false, "availability": "computable_now (warranty only, 34% coverage)"},
    "strengths":               {"inputs_required": ["editorial:strength"], "editorial_required": true, "availability": "needs_editorial"},
    "compromises":             {"inputs_required": ["editorial:compromise"], "editorial_required": true, "availability": "needs_editorial"},
    "buyer_fit":               {"inputs_required": ["the other signals"], "editorial_required": true, "availability": "needs_editorial", "note": "fit tags are produced by approved, versioned rules over signals; never by an LLM"}
  }
}
